  <link name="lift_link">
        <visual>
            <geometry>
                <box size="${lift_length} ${lift_width} ${lift_height}" />
            </geometry>
            <origin xyz="0 0 ${lift_height/2}" rpy="0 0 0" />
            <material name="grey" />
        </visual>
        <collision>
            <geometry>
                <box size="${lift_length} ${lift_width} ${lift_height}" />
            </geometry>
            <origin xyz="0 0 ${lift_height/2}" rpy="0 0 0" />
        </collision>
        <xacro:box_inertia m="2.0" x="${lift_length}" y="${lift_width}" z="${lift_height}" 
                            o_xyz="0 0 ${lift_height/2}" o_rpy="0 0 0" />
    </link>

    <link name="controller_link">
        <visual>
            <geometry>
                <box size="${controller_length} ${controller_width} ${controller_height}" />
            </geometry>
            <origin xyz="0 0 ${controller_height/2}" rpy="0 0 0" />
            <material name="green" />
        </visual>
        <collision>
            <geometry>
                <box size="${controller_length} ${controller_width} ${controller_height}" />
            </geometry>
            <origin xyz="0 0 ${controller_height/2}" rpy="0 0 0" />
        </collision>
        <xacro:box_inertia m="2.0" x="${controller_length}" y="${controller_width}" z="${controller_height}" 
                            o_xyz="0 0 ${controller_height/2}" o_rpy="0 0 0" />
    </link>

    <link name="head_link">
        <visual>
            <geometry>
                <cylinder radius="${head_radius}" length="${head_length}" />
            </geometry>
            <origin xyz="0 0 ${head_length/2}" rpy="0 0 0" />
            <material name="grey" />
        </visual>
        <collision>
            <geometry>
                <cylinder radius="${head_radius}" length="${head_length}" />
            </geometry>
            <origin xyz="0 0 ${head_length/2}" rpy="0 0 0" />
        </collision>
        <xacro:cylinder_inertia m="0.5" r="${head_radius}" l="${head_length}" o_xyz="0 0 ${head_length/2}" o_rpy="0 0 0" />
    </link>

    <link name="left_arm_link">
        <!-- <origin xyz="0 0 -0.15" rpy="0 0 0" /> -->
    </link>

    <link name="right_arm_link" >
        <!-- <origin xyz="0 -0.05 0.05" rpy="0 0 0" /> -->
    </link>

    <link name="base_footprint" />

    <joint name="base_joint" type="fixed">
        <parent link="base_footprint" />
        <child link="base_link" />
        <origin xyz="0 0 ${footprint_height}" rpy="0 0 0" />
    </joint>

    

    

    

    

    

    


    

    

   

    

    <joint name="base_lift_joint" type="prismatic">
        <parent link ="base_link" />
        <child link="lift_link" />
        <axis xyz="0 0 1" />
        <origin xyz="0 0 ${base_height}" rpy="0 0 0" />
        <limit lower="0" upper="2.2" effort="100.0" velocity="100.0" />
    </joint>

    <joint name="lift_controller_joint" type="fixed">
        <parent link ="lift_link" />
        <child link="controller_link" />
        <origin xyz="0 0 ${lift_height}" rpy="0 0 0" />
    </joint>

    <joint name="controller_head_joint" type="fixed">
        <parent link ="controller_link" />
        <child link="head_link" />
        <origin xyz="0 0 ${controller_height}" rpy="0 0 0" />
    </joint>

    <joint name="head_left_arm_joint" type="fixed">
        <parent link="head_link" />
        <child link="left_arm_link" />
        <origin xyz="0 0.03 0.05" rpy=" ${-pi/2} ${pi/2} 0" />
    </joint>

    <joint name="head_right_arm_joint" type="fixed">
        <parent link="head_link" />
        <child link="right_arm_link" />
        <origin xyz="0 -0.03 0.05" rpy="${pi/2} ${-pi/2} 0" />
    </joint>
    
</robot>
