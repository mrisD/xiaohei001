<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">
    <!-- <xacro:include filename="common_properties.xacro" /> -->
    <xacro:macro name="laser_xacro" params="xyz">
        <!-- 雷达支撑杆 -->
        <link name="laser_cylinder_link">
            <visual>
                <!-- 沿着自己几何中心的偏移和旋转 -->
                <origin xyz="0.0 0.0 0.0 " rpy="0.0 0.0 0.0"/>
                <geometry>
                    <cylinder radius="0.01" length="0.05"/>
                </geometry>
                <material name="orange"/>
            </visual>
            <collision>
                <origin xyz="0.0 0.0 0.0 " rpy="0.0 0.0 0.0"/>
                <geometry>
                    <cylinder radius="0.01" length="0.10"/>
                </geometry>
                <material name="orange"/>
            </collision>
            <xacro:cylinder_inertia m="0.05" r="0.01" l="0.10" o_xyz="0 0 0" o_rpy="0 0 0"/>
        </link>

        <!-- 雷达 -->
        <link name="laser_link">
            <visual>
                <!-- 沿着自己几何中心的偏移和旋转 -->
                <origin xyz="0.0 0.0 0.0 " rpy="0.0 0.0 0.0"/>
                <geometry>
                    <cylinder radius="0.02" length="0.02"/>
                </geometry>
                <material name="orange"/>
            </visual>
            <collision>
                <origin xyz="0.0 0.0 0.0 " rpy="0.0 0.0 0.0"/>
                <geometry>
                    <cylinder radius="0.02" length="0.02"/>
                </geometry>
                <material name="orange"/>
            </collision>
            <xacro:cylinder_inertia m="0.10" r="0.02" l="0.02" o_xyz="0 0 0" o_rpy="0 0 0"/>
        </link>

        <joint name="laser_joint" type="fixed">
            <parent link="laser_cylinder_link"/>
            <child link="laser_link"/>
            <origin xyz="0.0 0.0 0.025" rpy="0.0 0.0 0.0"/>
        </joint>

        <joint name="laser_cylinder_joint" type="fixed">
            <parent link="head_link"/>
            <child link="laser_cylinder_link"/>
            <origin xyz="${xyz}" rpy="0.0 0.0 0.0"/>
        </joint>
    </xacro:macro>

    <!-- <gazebo reference="laser_cylinder_link">
        <material>Gazebo/Black</material>
    </gazebo>
    <gazebo reference="laser_link">
        <material>Gazebo/Black</material>
    </gazebo> -->
</robot>
