<?xml version="1.0" ?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro" >
    <xacro:property name="base_length" value="0.412" />  
    <xacro:property name="base_width" value="0.323" /> 
    <xacro:property name="base_height" value="0.162" /> 

    <!-- <xacro:property name="base_length" value="0.6" /> 
    <xacro:property name="base_width" value="0.4" /> 
    <xacro:property name="base_height" value="0.2" />  -->

    <xacro:property name="lift_length" value="0.144" /> 
    <xacro:property name="lift_width" value="0.144" /> 
    <xacro:property name="lift_height" value="0.465" /> 
    <xacro:property name="lift_max" value="2.2" />

    <xacro:property name="controller_length" value="0.14" /> 
    <xacro:property name="controller_width" value="0.14" /> 
    <xacro:property name="controller_height" value="0.315" /> 

    <xacro:property name="head_radius" value="0.04" /> 
    <xacro:property name="head_length" value="0.1" /> 

    <xacro:property name="wheel_radius" value="0.1" /> 
    <xacro:property name="wheel_length" value="0.05" /> 

    <xacro:property name="caster_wheel_length" value="0.05" /> 

    <link name="base_footprint" />

    <link name="base_link">
        <visual>
            <geometry>
                <box size= "${base_length} ${base_width} ${base_height}" />
            </geometry>
            <origin xyz="0 0 ${base_height/2}" rpy="0 0 0" />
            <material name="green" />
        </visual>
        <collision>
            <geometry>
                <box size= "${base_length} ${base_width} ${base_height}" />
            </geometry>
            <origin xyz="0 0 ${base_height/2}" rpy="0 0 0" />
        </collision>
        <xacro:box_inertia m="5.0" x="${base_length}" y="${base_width}" z="${base_height}" 
                            o_xyz="0 0 ${base_height/2}" o_rpy="0 0 0" />
    </link>

    

    <link name="lift_link">
        <visual>
            <geometry>
                <box size="${lift_length} ${lift_width} ${lift_height}" />
            </geometry>
            <origin xyz="0 0 ${lift_height/2}" rpy="0 0 0" />
            <material name="grey" />
        </visual>
        <collision>
            <geometry>
                <box size="${lift_length} ${lift_width} ${lift_height}" />
            </geometry>
            <origin xyz="0 0 ${lift_height/2}" rpy="0 0 0" />
        </collision>
        <xacro:box_inertia m="2.0" x="${lift_length}" y="${lift_width}" z="${lift_height}" 
                            o_xyz="0 0 ${lift_height/2}" o_rpy="0 0 0" />
    </link>

    <link name="controller_link">
        <visual>
            <geometry>
                <box size="${controller_length} ${controller_width} ${controller_height}" />
            </geometry>
            <origin xyz="0 0 ${controller_height/2}" rpy="0 0 0" />
            <material name="green" />
        </visual>
        <collision>
            <geometry>
                <box size="${controller_length} ${controller_width} ${controller_height}" />
            </geometry>
            <origin xyz="0 0 ${controller_height/2}" rpy="0 0 0" />
        </collision>
        <xacro:box_inertia m="2.0" x="${controller_length}" y="${controller_width}" z="${controller_height}" 
                            o_xyz="0 0 ${controller_height/2}" o_rpy="0 0 0" />
    </link>

    <link name="head_link">
        <visual>
            <geometry>
                <cylinder radius="${head_radius}" length="${head_length}" />
            </geometry>
            <origin xyz="0 0 ${head_length/2}" rpy="0 0 0" />
            <material name="grey" />
        </visual>
        <collision>
            <geometry>
                <cylinder radius="${head_radius}" length="${head_length}" />
            </geometry>
            <origin xyz="0 0 ${head_length/2}" rpy="0 0 0" />
        </collision>
        <xacro:cylinder_inertia m="0.5" r="${head_radius}" l="${head_length}" o_xyz="0 0 ${head_length/2}" o_rpy="0 0 0" />
    </link>

    <link name="left_arm_link">
        <!-- <origin xyz="0 0.05 0.05" rpy="0 0 0" /> -->
    </link>

    <link name="right_arm_link" >
        <!-- <origin xyz="0 -0.05 0.05" rpy="0 0 0" /> -->
    </link>

    <link name="right_wheel_link">
        <visual>
            <geometry>
                <cylinder radius="${wheel_radius}" length="${wheel_length}" />
            </geometry>
            <origin xyz="0 0 0" rpy="${pi/2.0} 0 0" />
            <material name="grey" />
        </visual>
        <collision>
            <geometry>
                <cylinder radius="${wheel_radius}" length="${wheel_length}" />
            </geometry>
            <origin xyz="0 0 0" rpy="${pi/2.0} 0 0" />
        </collision>
        <xacro:cylinder_inertia m="1.0" r="${wheel_radius}" l="${wheel_length}"
                                    o_xyz="0 0 0" o_rpy="${pi / 2.0} 0 0" />
    </link>

    <link name="left_wheel_link">
        <visual>
            <geometry>
                <cylinder radius="${wheel_radius}" length="${wheel_length}" />
            </geometry>
            <origin xyz="0 0 0" rpy="${pi/2.0} 0 0" />
            <material name="grey" />
        </visual>
        <collision>
            <geometry>
                <cylinder radius="${wheel_radius}" length="${wheel_length}" />
            </geometry>
            <origin xyz="0 0 0" rpy="${pi/2.0} 0 0" />
        </collision>
        <xacro:cylinder_inertia m="1.0" r="${wheel_radius}" l="${wheel_length}"
                                    o_xyz="0 0 0" o_rpy="${pi / 2.0} 0 0" />
    </link>

    <link name ="left_caster_wheel_link">
        <visual>
            <geometry>
                <sphere radius="${caster_wheel_length}" />
            </geometry>
            <origin xyz="0 0 0" rpy="0 0 0" />
            <material name="grey" />
        </visual>
        <collision>
            <geometry>
                <sphere radius="${caster_wheel_length}" />
            </geometry>
            <origin xyz="0 0 0" rpy="0 0 0" />
            <material name="grey" />
        </collision>
        <xacro:sphere_inertia m="0.5" r="${caster_wheel_length}" o_xyz="0 0 0" o_rpy="0 0 0" />
    </link>

    <link name ="right_caster_wheel_link">
        <visual>
            <geometry>
                <sphere radius="${caster_wheel_length}" />
            </geometry>
            <origin xyz="0 0 0" rpy="0 0 0" />
            <material name="grey" />
        </visual>
        <collision>
            <geometry>
                <sphere radius="${caster_wheel_length}" />
            </geometry>
            <origin xyz="0 0 0" rpy="0 0 0" />
            <material name="grey" />
        </collision>
        <xacro:sphere_inertia m="0.5" r="${caster_wheel_length}" o_xyz="0 0 0" o_rpy="0 0 0" />
    </link>

    

    <joint name="base_joint" type="fixed">
        <parent link="base_footprint" />
        <child link="base_link" />
        <origin xyz="0 0 ${wheel_radius}" rpy="0 0 0" />
    </joint>

    <joint name="base_right_wheel_joint" type="continuous">
        <parent link="base_link" />
        <child link="right_wheel_link" />
        <!-- <origin xyz="${-base_length/4} ${-base_width/2-wheel_length/2} 0" rpy="0 0 0" /> -->
        <origin xyz="${-base_length/4} ${-base_width/4} 0" rpy="0 0 0" />

        <axis xyz="0 1 0" />
    </joint>

    <joint name="base_left_wheel_joint" type="continuous">
        <parent link="base_link" />
        <child link="left_wheel_link" />
        <!-- <origin xyz="${-base_length/4} ${base_width/2+wheel_length/2} 0" rpy="0 0 0" /> -->
        <origin xyz="${-base_length/4} ${base_width/4} 0" rpy="0 0 0" />
        <axis xyz="0 1 0" />
    </joint>

    <joint name="base_left_caster_wheel_joint" type="fixed">
        <parent link="base_link" />
        <child link="left_caster_wheel_link" />
        <origin xyz="0.1 ${base_width/4} ${-caster_wheel_length}" rpy="0 0 0" />
    </joint>

    <joint name="base_right_caster_wheel_joint" type="fixed">
        <parent link="base_link" />
        <child link="right_caster_wheel_link" />
        <origin xyz="0.1 ${-base_width/4} ${-caster_wheel_length}" rpy="0 0 0" />
    </joint>

    

    

    <joint name="base_lift_joint" type="prismatic">
        <parent link ="base_link" />
        <child link="lift_link" />
        <axis xyz="0 0 1" />
        <origin xyz="0 0 ${base_height}" rpy="0 0 0" />
        <limit lower="0" upper="2.2" effort="100.0" velocity="100.0" />
    </joint>

    <joint name="lift_controller_joint" type="fixed">
        <parent link ="lift_link" />
        <child link="controller_link" />
        <origin xyz="0 0 ${lift_height}" rpy="0 0 0" />
    </joint>

    <joint name="controller_head_joint" type="fixed">
        <parent link ="controller_link" />
        <child link="head_link" />
        <origin xyz="0 0 ${controller_height}" rpy="0 0 0" />
    </joint>

    <joint name="head_left_arm_joint" type="fixed">
        <parent link="head_link" />
        <child link="left_arm_link" />
        <origin xyz="0 0.05 0.05" rpy=" ${-pi/2} ${pi/2} 0" />
    </joint>

    <joint name="head_right_arm_joint" type="fixed">
        <parent link="head_link" />
        <child link="right_arm_link" />
        <origin xyz="0 -0.05 0.05" rpy="${pi/2} ${-pi/2} 0" />
    </joint>
</robot>